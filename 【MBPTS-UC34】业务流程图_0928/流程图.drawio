        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% ========== Case5a X-ENTRY ==========\n    subgraph C5A[\&quot;Case5a · X-ENTRY（SharePoint 拖入送货邮件触发）\&quot;]\n        direction LR\n        A1[\&quot;任务1&lt;br/&gt;获取需制作ASN的&lt;br/&gt;送货邮件\&quot;] -.-&gt; A1_1[\&quot;SharePoint：读取业务拖入的&lt;br/&gt;送货邮件（T11）\&quot;]\n        A1_1 --&gt; A1_2[\&quot;excel：从货物签收单&lt;br/&gt;获取AWB No.\&quot;]\n\n        A2[\&quot;任务2&lt;br/&gt;对任务1中单票&lt;br/&gt;填写DSS模板\&quot;] -.-&gt; A2_1[\&quot;excel：诊断仪大表按AWB&lt;br/&gt;获取PN/QTY/ID No.（R11）\&quot;]\n        A2_1 --&gt; A2_D1{\&quot;MBPTS PO&lt;br/&gt;已回填？（D11）\&quot;}\n        A2_D1 -- 为空 --&gt; A2_E1[\&quot;报错转人工&lt;br/&gt;本票阻断（E11）\&quot;]\n        A2_E1 -.-&gt; A2_H1[\&quot;Portal：手工补录ID No.&lt;br/&gt;下次运行继续（H01）\&quot;]\n        A2_D1 -- 已有PO --&gt; A2_D2{\&quot;同Material&lt;br/&gt;多Item No.？（D12）\&quot;}\n        A2_D2 -- 是 --&gt; A2_2[\&quot;excel：多Item&lt;br/&gt;顺次收货多行（R13）\&quot;]\n        A2_D2 -- 否 --&gt; A2_3[\&quot;excel：单Item&lt;br/&gt;单行填写（R14）\&quot;]\n        A2_2 --&gt; A2_4[\&quot;SharePoint：按AWB No.&lt;br/&gt;获取发票邮件附件（R16）\&quot;]\n        A2_3 --&gt; A2_4\n        A2_4 --&gt; A2_5[\&quot;agent：识别发票PDF&lt;br/&gt;Our delivery note No./Document date\&quot;]\n        A2_5 --&gt; A2_6[\&quot;excel：按映射关系&lt;br/&gt;填写DSS模板（R15）\&quot;]\n        A2_6 --&gt; A2_7[\&quot;文件归档&lt;br/&gt;（AWB No._日期）\&quot;]\n\n        A3[\&quot;任务3&lt;br/&gt;汇总任务结果&lt;br/&gt;并发布\&quot;] -.-&gt; A3_1[\&quot;获取本批任务2的结果\&quot;]\n        A3_1 --&gt; A3_2[\&quot;填写收货记录表&lt;br/&gt;自动+手工（G01）\&quot;]\n        A3_2 --&gt; A3_3[\&quot;Portal：发布DSS模板（O11）&lt;br/&gt;收货记录可查询（O12）\&quot;]\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="air9oGGXX2Zi4x91LxpJ-61">
