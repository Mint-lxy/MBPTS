        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start[\&quot;任务触发&lt;br/&gt;空运每晚 00:00 / 海运每周一（跑上周一至周日）&lt;br/&gt;支持手动触发\&quot;]\n\n    Start --&gt; ExportPrealert[\&quot;IES：筛选并导出预报清单&lt;br/&gt;空运 DGR + 当天 / 海运 Sea + 四库 + 上周区间\&quot;]\n    ExportPrealert --&gt; ExportPartList[\&quot;IES：按 HAWB/BL No. 批量查询&lt;br/&gt;导出 Part List\&quot;]\n    ExportPrealert -- 导出失败 --&gt; ExportFail[\&quot;任务失败，转人工处理后重跑\&quot;]\n    ExportPartList -- 导出失败 --&gt; ExportFail\n    ExportPartList --&gt; DownloadShipper[\&quot;IES：按 BL/HAWB 下载 Shippers_Decl\&quot;]\n\n    DownloadShipper --&gt; DownloadOK{\&quot;下载成功？\&quot;}\n    DownloadOK -- 否 --&gt; RecordMissing[\&quot;记录缺失&lt;br/&gt;备注：Not found shippers_Decl\&quot;]\n    DownloadOK -- 是 --&gt; UNCheck\n    RecordMissing -- 记录后继续 --&gt; UNCheck\n\n    UNCheck[\&quot;excel：UN 编号匹配初筛&lt;br/&gt;Part List 的 UN Number 对照附表4\&quot;]\n    UNCheck --&gt; UNResult{\&quot;是否需要&lt;br/&gt;进入后续处理？\&quot;}\n    UNResult -- \&quot;不需要 / 无匹配\&quot; --&gt; ExcludeLine[\&quot;排除该货物行&lt;br/&gt;不进入危险货物明细，保留用于整票判断\&quot;]\n    UNResult -- \&quot;需要 / 套装 / 其他候选\&quot; --&gt; OCRShipper[\&quot;agent：识别 Shippers_Decl&lt;br/&gt;提取 18 项字段\&quot;]\n\n    OCRShipper --&gt; OCRCheck{\&quot;识别结果&lt;br/&gt;是否可信？\&quot;}\n    OCRCheck -- 不可信 --&gt; OCRManual[\&quot;转人工核对&lt;br/&gt;修正字段后从识别步骤重跑\&quot;]\n    OCRManual -.-&gt; OCRShipper\n    OCRCheck -- 可信 --&gt; FillHeader[\&quot;excel：填写清单表头&lt;br/&gt;按 PDC + 发票类型 + 危险品库房匹配\&quot;]\n\n    FillHeader --&gt; HeaderMatch{\&quot;表头信息&lt;br/&gt;是否匹配成功？\&quot;}\n    HeaderMatch -- 未匹配 --&gt; HeaderFail[\&quot;任务失败并站内提醒&lt;br/&gt;管理员维护附表1后重跑\&quot;]\n    HeaderFail -.-&gt; FillHeader\n    HeaderMatch -- 匹配成功 --&gt; IsSet{\&quot;该货物&lt;br/&gt;是否为套装？\&quot;}\n\n    IsSet -- 否 --&gt; TypeSplit{\&quot;按危险品类型分流\&quot;}\n    TypeSplit -- \&quot;类型一：确定制作\&quot; --&gt; Type1[\&quot;excel：直接填写危险货物明细\&quot;]\n    TypeSplit -- \&quot;类型二：确定制作\&quot; --&gt; Type2[\&quot;IES：下载 SDS&lt;br/&gt;agent：识别 SDS 第 14 章运输信息\&quot;]\n    TypeSplit -- \&quot;类型三：待定\&quot; --&gt; Type3[\&quot;IES：查询 Hazmat 标识&lt;br/&gt;是则纳入并查 SDS，否则不纳入\&quot;]\n    TypeSplit -- \&quot;类型四：待定\&quot; --&gt; Type4[\&quot;excel：判断包装净重&lt;br/&gt;不超过 4kg 不纳入，超过则继续\&quot;]\n\n    IsSet -- 是 --&gt; SetRead[\&quot;agent：读取 Shippers_Decl&lt;br/&gt;提取套装内全部 UN 编号\&quot;]\n    SetRead --&gt; SetType[\&quot;逐个 UN 编号识别危险品类型\&quot;]\n    SetType --&gt; SetRule{\&quot;按对应类型规则判断&lt;br/&gt;是否制作、如何制作\&quot;}\n\n    Type1 --&gt; Merge[\&quot;汇总所有货物行的&lt;br/&gt;纳入 / 排除结果\&quot;]\n    Type2 --&gt; Merge\n    Type3 -- \&quot;纳入 / 排除\&quot; --&gt; Merge\n    Type4 -- \&quot;纳入 / 排除\&quot; --&gt; Merge\n    SetRule -- 逐条结论 --&gt; Merge\n    ExcludeLine -- 参与整票判断 --&gt; Merge\n\n    Merge --&gt; NeedList{\&quot;本票是否存在&lt;br/&gt;需纳入的危险货物？\&quot;}\n    NeedList -- 是 --&gt; MakeList[\&quot;excel：生成托运清单&lt;br/&gt;一票一份，含表头和危险货物明细\&quot;]\n    MakeList --&gt; UploadIES[\&quot;IES：命名并上传&lt;br/&gt;道路运输危险货物托运清单_BL/HAWB&lt;br/&gt;未取得上传回执则转人工\&quot;]\n    NeedList -- 否 --&gt; NoNeed[\&quot;记录本票无需制作&lt;br/&gt;Consignment list not required\&quot;]\n\n    UploadIES --&gt; Archive[\&quot;文件归档 SharePoint&lt;br/&gt;按操作日期 / BL·HAWB 两级目录存放\&quot;]\n    NoNeed --&gt; Archive\n    Archive --&gt; Summary[\&quot;汇总本次运行结果&lt;br/&gt;Shippers_Decl / 清单状态 / 备注 / 处理日期\&quot;]\n\n    Summary --&gt; StatusSheet[\&quot;填写运行状态表&lt;br/&gt;按年度累积\&quot;]\n    StatusSheet --&gt; Mail[\&quot;邮件发送 IO 同事&lt;br/&gt;附本次运行状态表\&quot;]\n\n    Summary -.任务状态反馈.-&gt; Board[\&quot;Portal：查看任务状态&lt;br/&gt;执行中 / 成功 / 失败\&quot;]\n    Board -.失败任务.-&gt; Resubmit[\&quot;Portal：异常修正后重新提交&lt;br/&gt;在 IES 修正源数据，随下次同运输方式调度执行\&quot;]\n    Resubmit -.重新提交.-&gt; Start&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="air9oGGXX2Zi4x91LxpJ-222">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
